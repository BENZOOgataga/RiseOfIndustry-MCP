<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <IsPackable>false</IsPackable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RoiGameDir Condition="'$(RoiGameDir)' == '' and '$(ROI_GAME_DIR)' != ''">$(ROI_GAME_DIR)</RoiGameDir>
    <RoiGameDir Condition="'$(RoiGameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\RiseOfIndustry</RoiGameDir>
    <RoiManagedDir>$(RoiGameDir)\Rise of Industry_Data\Managed</RoiManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RoiMcp.Observer\RoiMcp.Observer.csproj" />
  </ItemGroup>

  <!-- The observer compiles against the game copy (11.0.2); tests run with a newer binary-compatible version via binding redirects. -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
