{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roi-mcp.local/schemas/static.schema.json",
  "title": "Rise of Industry MCP static.json",
  "x-schema-version": "1.0.0",
  "description": "Common envelope of heartbeat/static/state/history files (PRD 11.2).",
  "type": "object",
  "additionalProperties": false,
  "x-envelope": true,
  "properties": {
    "schema": {
      "const": "roi-mcp/static"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "observer_version": {
      "type": "string"
    },
    "compatibility": {
      "const": "verified"
    },
    "game": {
      "anyOf": [
        {
          "$ref": "#/$defs/GameInfoDto"
        },
        {
          "type": "null"
        }
      ],
      "description": "detected game facts; heartbeat before the first READY: null"
    },
    "pid": {
      "type": "integer"
    },
    "world_session": {
      "type": "string"
    },
    "seq": {
      "type": "integer"
    },
    "content_hash": {
      "type": "string"
    },
    "written_utc": {
      "type": "string"
    },
    "captured": {
      "$ref": "#/$defs/CapturedDto"
    },
    "static_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StaticRefDto"
        },
        {
          "type": "null"
        }
      ]
    },
    "sections": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/SectionStatusDto"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WarningDto"
      }
    },
    "data": {
      "$ref": "#/$defs/StaticData"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "observer_version",
    "compatibility",
    "game",
    "pid",
    "world_session",
    "seq",
    "content_hash",
    "written_utc",
    "captured",
    "static_ref",
    "sections",
    "warnings",
    "data"
  ],
